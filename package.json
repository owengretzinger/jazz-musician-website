    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "next": "16.3.1",
    "plaiceholder": "^3.0.0",
    "postcss": "8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^4.10.1",
    "sharp": "0.35.3",
    "slate": "0.118.1",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.1",
